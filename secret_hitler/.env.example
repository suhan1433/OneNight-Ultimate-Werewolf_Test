# Export these variables before running npm scripts, or supply them in your host.
PORT=3007
# Absolute path to private durable journals. Keep outside the public web directory.
DATA_DIR=/absolute/path/to/secret-hitler-data
# Additional cross-origin clients, comma separated. Same-origin web works automatically.
WEB_ORIGIN=http://localhost:5179,http://127.0.0.1:5179
# Client build only: leave unset for same-origin web / development proxy.
# VITE_SERVER_URL=https://your-server.example
# Native clients: add capacitor://localhost,http://localhost,https://localhost to WEB_ORIGIN.
