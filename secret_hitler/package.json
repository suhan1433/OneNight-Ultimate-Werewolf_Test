{
  "name": "secret-hitler-online",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n server,client \"npm run dev -w @secret-hitler/server\" \"npm run dev -w @secret-hitler/client\"",
    "build": "tsc --noEmit && npm run build -w @secret-hitler/client",
    "typecheck": "tsc --noEmit",
    "start": "npm run start -w @secret-hitler/server",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:simulation": "node --import tsx --test tests/simulation.test.ts",
    "build:app": "CAPACITOR_BUILD=true npm run build",
    "native:sync": "cap sync",
    "native:ios": "cap add ios",
    "native:android": "cap add android",
    "native:open:ios": "cap open ios",
    "native:open:android": "cap open android"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@playwright/test": "^1.49.0",
    "concurrently": "^9.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "@capacitor/cli": "^7.0.0"
  },
  "dependencies": {
    "@capacitor/core": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "@capacitor/android": "^7.0.0"
  }
}
