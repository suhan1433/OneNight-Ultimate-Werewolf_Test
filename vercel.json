{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "fluid": true,
  "regions": ["icn1"],
  "installCommand": "npm ci && npm --prefix avalon ci && npm --prefix bloodbound ci",
  "buildCommand": "npm run build",
  "outputDirectory": "apps/web/dist",
  "functions": {
    "api/socket.mjs": {
      "maxDuration": 300
    },
    "api/avalon/socket.mjs": {
      "maxDuration": 300
    },
    "api/bloodbound/socket.mjs": {
      "maxDuration": 300
    }
  }
}
