{
  "name": "lumen-tether",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n relay,web 'node server/index.mjs' 'vite'",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "start": "node server/index.mjs",
    "test:browser": "node tests/browser.mjs",
    "lint": "eslint src",
    "balance": "tsx tools/balance-bot.ts",
    "balance:coop": "tsx tools/coop-bot.ts"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "idb": "^8.0.4",
    "pixi.js": "^8.23.0",
    "preact": "^11.2.0",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.11",
    "concurrently": "^9.2.5",
    "eslint": "^9.39.5",
    "playwright": "^1.65.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^7.3.8",
    "vite-plugin-pwa": "^1.3.0"
  }
}
