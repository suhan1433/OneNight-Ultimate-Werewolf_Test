{
  "name": "@werewolf/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "RUN_STANDALONE_SERVER=true tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "RUN_STANDALONE_SERVER=true node dist/server.js",
    "test": "vitest run",
    "typecheck": "npm run build -w @werewolf/shared && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "@werewolf/shared": "*",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "ioredis": "^5.4.0",
    "pino": "^9.5.0",
    "socket.io": "^4.8.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^5.0.1"
  }
}
