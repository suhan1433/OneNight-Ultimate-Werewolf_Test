map $http_upgrade $connection_upgrade {
  default upgrade;
  '' close;
}

server {
  listen ${PORT};
  server_name _;

  location /api/socket/ {
    proxy_pass http://127.0.0.1:3001/socket.io/;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Host $host;
    proxy_read_timeout 3600s;
  }

  location /api/avalon/socket/ {
    proxy_pass http://127.0.0.1:3002/socket.io/;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Host $host;
    proxy_read_timeout 3600s;
  }

  location /api/bloodbound/socket/ {
    proxy_pass http://127.0.0.1:3003/socket.io/;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Host $host;
    proxy_read_timeout 3600s;
  }

  location = /health {
    proxy_pass http://127.0.0.1:3001/health;
  }

  location /werewolf/ {
    alias /app/apps/web/dist/werewolf/;
    try_files $uri $uri/ /werewolf/index.html;
  }

  location /avalon/ {
    alias /app/apps/web/dist/avalon/;
    try_files $uri $uri/ /avalon/index.html;
  }

  location /bloodbound/ {
    alias /app/apps/web/dist/bloodbound/;
    try_files $uri $uri/ /bloodbound/index.html;
  }

  location / {
    root /app/apps/web/dist;
    try_files $uri $uri/ /index.html;
  }
}
