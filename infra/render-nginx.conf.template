map $http_upgrade $connection_upgrade {
  default upgrade;
  '' close;
}

server {
  listen ${PORT};
  server_name _;

  location /api/socket/ {
    proxy_pass http://127.0.0.1:3001/socket.io/;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Host $host;
    proxy_read_timeout 3600s;
  }

  location /api/avalon/socket/ {
    proxy_pass http://127.0.0.1:3002/socket.io/;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Host $host;
    proxy_read_timeout 3600s;
  }

  location /api/skullking/socket/ {
    proxy_pass http://127.0.0.1:3004/socket.io/;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Host $host;
    proxy_read_timeout 3600s;
  }

  location /api/spacecrew/socket/ {
    proxy_pass http://127.0.0.1:3005/socket.io/;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Host $host;
    proxy_read_timeout 3600s;
  }

  location /api/rummikub/socket/ {
    proxy_pass http://127.0.0.1:3006/socket.io/;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Host $host;
    proxy_read_timeout 3600s;
  }

  # Gomoku keeps its full Socket.IO path; do not rewrite it to /socket.io/.
  location /api/gomoku/socket/ {
    proxy_pass http://127.0.0.1:3011;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Host $host;
    proxy_read_timeout 3600s;
  }

  location = /api/gomoku/health {
    proxy_pass http://127.0.0.1:3011/health;
  }

  location = /gomoku {
    absolute_redirect off;
    return 301 /gomoku/$is_args$args;
  }

  location /gomoku/ {
    alias /app/apps/web/dist/gomoku/;
    try_files $uri $uri/ /gomoku/index.html;
  }

  location = /api/hushfall/socket {
    proxy_pass http://127.0.0.1:3012;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_read_timeout 120s;
  }

  location = /api/hushfall/health {
    proxy_pass http://127.0.0.1:3012/health;
  }

  location = /hushfall {
    absolute_redirect off;
    return 301 /hushfall/$is_args$args;
  }

  location /hushfall/ {
    alias /app/apps/web/dist/hushfall/;
    try_files $uri $uri/ /hushfall/index.html;
  }

  location = /health {
    proxy_pass http://127.0.0.1:3001/health;
  }

  location /api/deception/socket/ {
    proxy_pass http://127.0.0.1:3007/socket.io/;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Host $http_host;
    proxy_read_timeout 3600s;
  }

  location = /api/deception/health {
    proxy_pass http://127.0.0.1:3007/health;
  }

  location /secret_hitler/socket.io/ {
    proxy_pass http://127.0.0.1:3008;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Host $http_host;
    proxy_read_timeout 3600s;
  }

  location = /api/secret_hitler/health {
    proxy_pass http://127.0.0.1:3008/health;
  }

  location = /secret_hitler {
    absolute_redirect off;
    return 301 /secret_hitler/$is_args$args;
  }

  location /secret_hitler/ {
    alias /app/apps/web/dist/secret_hitler/;
    try_files $uri $uri/ /secret_hitler/index.html;
  }

  location = /deception {
    absolute_redirect off;
    return 301 /deception/$is_args$args;
  }

  location /deception/ {
    alias /app/apps/web/dist/deception/;
    try_files $uri $uri/ /deception/index.html;
  }

  location /werewolf/ {
    alias /app/apps/web/dist/werewolf/;
    try_files $uri $uri/ /werewolf/index.html;
  }

  location /avalon/ {
    alias /app/apps/web/dist/avalon/;
    try_files $uri $uri/ /avalon/index.html;
  }

  location /skullking/ {
    alias /app/apps/web/dist/skullking/;
    try_files $uri $uri/ /skullking/index.html;
  }

  location /spacecrew/ {
    alias /app/apps/web/dist/spacecrew/;
    try_files $uri $uri/ /spacecrew/index.html;
  }

  location /rummikub/ {
    alias /app/apps/web/dist/rummikub/;
    try_files $uri $uri/ /rummikub/index.html;
  }

  location / {
    root /app/apps/web/dist;
    try_files $uri $uri/ /index.html;
  }
}
