{
  "name": "the-crew-planet-nine-online",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,web -c magenta,cyan \"npm run dev:server\" \"npm run dev:web\"",
    "dev:server": "node --watch server.mjs",
    "dev:web": "vite",
    "build": "tsc -b && vite build",
    "start": "node server.mjs",
    "test": "node --test server.test.mjs"
  },
  "dependencies": {
    "express": "^4.21.0",
    "socket.io": "^4.8.0",
    "socket.io-client": "^4.8.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.0.0",
    "typescript": "^5.7.0",
    "vite": "^5.4.10"
  }
}
